DATABASE_URL=postgresql://user:password@host:5432/milieualert
JWT_SECRET=your-jwt-secret-here
# Optional. If missing, POST /api/ai/assist still returns rule-based driving advice.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
PORT=3000
NODE_ENV=production
# Optional map tile keys. Without them the backend proxies OSM raster tiles.
# Do not point the PWA at keyless Carto (watermarked "API KEY REQUIRED").
CARTO_API_KEY=
MAPTILER_KEY=
STADIA_KEY=
# Shared secret for GS ↔ MA (header: x-billing-admin-key).
BILLING_ADMIN_KEY=
# GS customer sync after register/premium (defaults to gestionesemplificata.com).
GS_API_URL=https://gestionesemplificata.com
# Optional alias for BILLING_ADMIN_KEY when calling GS.
GS_BILLING_ADMIN_KEY=
